{
  "description": "The tool's outputSchema requires temperature, so its error result does not validate.",
  "requirements": ["HCS-0006-R008"],
  "level": "document",
  "target": "urn:hcs:schema:hcs-0006:error:0.1#/$defs/toolCallOutput",
  "input": {
    "outputSchema": {
      "type": "object",
      "required": ["temperature"],
      "properties": { "temperature": { "type": "number" } }
    },
    "result": {
      "content": [{ "type": "text", "text": "Slow" }],
      "isError": true,
      "structuredContent": { "hcsError": { "code": "timeout", "message": "Slow" } }
    }
  },
  "expect": { "outcome": "invalid", "errors": [{ "code": "manifest_invalid" }] }
}
