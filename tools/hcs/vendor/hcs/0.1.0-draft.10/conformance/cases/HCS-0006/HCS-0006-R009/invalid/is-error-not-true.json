{
  "description": "A result whose isError is not true carries no HCS error, even with a valid hcsError member.",
  "requirements": ["HCS-0006-R009"],
  "level": "client",
  "input": {
    "response": {
      "jsonrpc": "2.0",
      "id": 9,
      "result": {
        "content": [{ "type": "text", "text": "ok" }],
        "isError": false,
        "structuredContent": { "hcsError": { "code": "timeout", "message": "Slow" } }
      }
    }
  },
  "expect": { "hcsError": null }
}
