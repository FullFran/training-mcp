{
  "description": "The tool's outputSchema has an alternative that requires hcsError, so its error result validates.",
  "requirements": ["HCS-0006-R008"],
  "level": "document",
  "target": "urn:hcs:schema:hcs-0006:error:0.1#/$defs/toolCallOutput",
  "input": {
    "outputSchema": {
      "type": "object",
      "anyOf": [
        { "type": "object", "required": ["temperature"], "properties": { "temperature": { "type": "number" } } },
        { "type": "object", "required": ["hcsError"], "properties": { "hcsError": { "type": "object" } } }
      ]
    },
    "result": {
      "content": [{ "type": "text", "text": "Slow" }],
      "isError": true,
      "structuredContent": { "hcsError": { "code": "timeout", "message": "Slow" } }
    }
  },
  "expect": { "outcome": "valid" }
}
