{
  "description": "A grant for another entry does not apply.",
  "requirements": [
    "HCS-0005-R001"
  ],
  "level": "authority",
  "input": {
    "requests": [],
    "grants": [
      {
        "entry": "dev.example.b",
        "permission": "dev.example.fs.read"
      }
    ],
    "check": {
      "entry": "dev.example.a",
      "permission": "dev.example.fs.read"
    }
  },
  "expect": {
    "decision": {
      "allow": false,
      "error": {
        "code": "permission_denied",
        "message": "denied"
      }
    }
  }
}
