{
  "description": "A request alone is not a grant.",
  "requirements": [
    "HCS-0005-R002"
  ],
  "level": "authority",
  "input": {
    "requests": [
      {
        "hcsVersion": "0.1",
        "entry": "dev.example.a",
        "requests": [
          {
            "permission": "dev.example.fs.read",
            "reason": "read notes"
          }
        ]
      }
    ],
    "grants": [],
    "check": {
      "entry": "dev.example.a",
      "permission": "dev.example.fs.read"
    }
  },
  "expect": {
    "decision": {
      "allow": false,
      "error": {
        "code": "permission_denied",
        "message": "denied"
      }
    }
  }
}
