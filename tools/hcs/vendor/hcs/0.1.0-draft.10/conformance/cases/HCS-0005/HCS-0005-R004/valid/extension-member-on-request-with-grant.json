{
  "description": "An x- member on a request does not prevent a grant from applying.",
  "requirements": [
    "HCS-0005-R004"
  ],
  "level": "authority",
  "input": {
    "requests": [
      {
        "hcsVersion": "0.1",
        "entry": "dev.example.a",
        "requests": [
          {
            "permission": "dev.example.fs.read",
            "reason": "read notes",
            "x-example-ui-hint": "files"
          }
        ]
      }
    ],
    "grants": [
      {
        "entry": "dev.example.a",
        "permission": "dev.example.fs.read"
      }
    ],
    "check": {
      "entry": "dev.example.a",
      "permission": "dev.example.fs.read"
    }
  },
  "expect": {
    "decision": {
      "allow": true
    }
  }
}
