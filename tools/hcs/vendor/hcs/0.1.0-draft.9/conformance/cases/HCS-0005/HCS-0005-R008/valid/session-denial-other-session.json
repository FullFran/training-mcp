    "HCS-0005-R008"
  ],
  "level": "authority",
  "input": {
    "requests": [],
    "grants": [
      {
        "entry": "dev.example.a",
        "permission": "dev.example.mail.send"
      }
    ],
    "check": {
      "entry": "dev.example.a",
      "permission": "dev.example.mail.send",
