// Service worker for the training PWA.
//
// Deliberately minimal: the shell is cached so the app opens instantly, and
// pages are cached opportunistically so a lost connection still shows the last
// known session. Writes are NOT queued offline — a set only counts once the
// server has stored it, and a silent queue would let you believe otherwise.
//
// At the root, several people may sign in on one device. Every signed-in page
// names its session's cache partition in X-Cache-Partition ("<id>-<expiry>"), and
// only that partition is ever read offline: a new session drops the others, an
// expired one is dropped before reading, and the logged-out page (X-Cache-Clear)
// drops them all. The secret mount sends no partition and keeps the old cache.
const VERSION = 'v17';
const SHELL = 'shell-' + VERSION;
const PAGES = 'pages-' + VERSION;
const BASE = '{{.Base}}';
const USER_PAGES = 'user-pages-';
const PARTITION = /^[A-Za-z0-9_]+-(\d+)$/;

const SHELL_ASSETS = [
  BASE + '/static/app.css',
  BASE + '/static/app.js',
  BASE + '/static/coach.js',
  BASE + '/static/markdown.js',
  BASE + '/static/coach-attach.js',
  BASE + '/static/coach-apply.js',
  BASE + '/static/coach-undo.js',
  BASE + '/static/shell.js',
  BASE + '/static/modes.js',
  BASE + '/static/progress.js',
  BASE + '/static/picker.js',
  BASE + '/static/htmx.min.js',
  BASE + '/static/icon-192.png',
  BASE + '/static/icon-512.png'
];

self.addEventListener('install', (event) => {
  event.waitUntil(
    caches.open(SHELL).then((cache) => cache.addAll(SHELL_ASSETS)).then(() => self.skipWaiting())
  );
});

self.addEventListener('activate', (event) => {
  event.waitUntil(
    caches.keys()
      .then((keys) => Promise.all(
        keys.filter((k) => k !== SHELL && k !== PAGES && !k.startsWith(USER_PAGES)).map((k) => caches.delete(k))
      ))
      .then(() => self.clients.claim())
  );
});

self.addEventListener('fetch', (event) => {
  const request = event.request;
  if (request.method !== 'GET') return; // writes always go to the network

  const url = new URL(request.url);
  if (url.origin !== self.location.origin) return;
  // The coach's status and its live stream are never cached or replayed.
  if (url.pathname.startsWith(BASE + '/coach/')) return;

  // Static assets are content-stable: serve from cache, refresh in background.
  if (url.pathname.startsWith(BASE + '/static/')) {
    event.respondWith(
      caches.match(request).then((hit) => hit || fetch(request).then((res) => {
        const copy = res.clone();
        caches.open(SHELL).then((cache) => cache.put(request, copy));
        return res;
      }))
    );
    return;
  }

  // Pages must be fresh when online; fall back to the last copy when offline.
  event.respondWith(
    fetch(request)
      .then((res) => {
        event.waitUntil(remember(request, res.clone()));
        return res;
      })
      .catch(() => offlineCopy(request))
  );
});

// dropUserPages deletes every signed-in partition except keep.
function dropUserPages(keep) {
  return caches.keys().then((keys) => Promise.all(
    keys.filter((k) => k.startsWith(USER_PAGES) && k !== keep).map((k) => caches.delete(k))
  ));
}

// pageKey files the home under one key for every ?modo=: it is one page that
// switches screens itself, so a reload offline on any screen finds it.
function pageKey(request) {
  const url = new URL(request.url);
  return url.pathname === BASE + '/' ? url.origin + url.pathname : request;
}

function remember(request, res) {
  if (res.headers.get('X-Cache-Clear')) return dropUserPages(null);
  // An error is never worth showing offline in place of the last good page.
  if (!res.ok) return Promise.resolve();
  const partition = res.headers.get('X-Cache-Partition');
  if (partition === null) {
    return caches.open(PAGES).then((cache) => cache.put(pageKey(request), res));
  }
  if (!PARTITION.test(partition)) return Promise.resolve();
  const name = USER_PAGES + partition;
  return caches.open(name)
    .then((cache) => cache.put(pageKey(request), res))
    .then(() => dropUserPages(name));
}

// livePartition returns the one signed-in partition still valid, dropping any
// whose session has ended.
function livePartition() {
  const now = Date.now() / 1000;
  return caches.keys().then((keys) => {
    const owned = keys.filter((k) => k.startsWith(USER_PAGES));
    const live = owned.filter((k) => {
      const m = PARTITION.exec(k.slice(USER_PAGES.length));
      return m && Number(m[1]) > now;
    });
    const keep = live.length === 1 ? live[0] : null;
    return Promise.all(owned.filter((k) => k !== keep).map((k) => caches.delete(k))).then(() => keep);
  });
}

// offlineCopy reads the live partition first. Signed-in pages are only ever
// filed there, so falling back to PAGES serves the secret mount's pages, which
// share this origin's caches, and never another session's.
function offlineCopy(request) {
  return livePartition()
    .then((name) => name ? caches.open(name).then((cache) => cache.match(pageKey(request))) : undefined)
    .then((hit) => hit || caches.match(pageKey(request), { cacheName: PAGES }));
}
